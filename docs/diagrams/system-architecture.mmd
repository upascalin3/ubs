%% Utility Billing System - System Architecture Overview
flowchart LR
    subgraph Users["System Users"]
        Admin["Admin"]
        Operator["Operator"]
        Finance["Finance"]
        Customer["Customer"]
    end

    subgraph Entry["API Entry Points"]
        Swagger["Swagger UI\n/api-docs, /swagger-ui.html"]
        RestApi["REST API\n/api/**"]
        Postman["Postman test collection"]
    end

    subgraph App["Spring Boot 3.5 Modular Monolith"]
        Security["Security Layer\nJWT, stateless sessions, role-based method security"]
        Common["Common Layer\nvalidation, exceptions, ApiResponse, OpenAPI, auditing support"]

        subgraph Modules["Domain Modules"]
            Auth["Auth Module\nregistration, login, OTP, refresh tokens, password reset"]
            CustomerModule["Customer Module\nusers as customers, meters, file uploads"]
            MeterModule["Meter Module\nmeter reading capture and history"]
            BillingModule["Billing Module\ntariffs, bill generation, approvals, stored procedure"]
            PaymentModule["Payment Module\npayment recording, balance updates"]
            NotificationModule["Notification Module\nin-app notifications"]
            AuditModule["Audit Module\nbusiness audit logs"]
            ReportModule["Report Module\nuser, billing, payment, revenue summaries"]
        end

        Scheduler["Monthly Billing Scheduler\ncalls billing.generate_monthly_bills()"]
    end

    subgraph Data["PostgreSQL 16 Database"]
        Flyway["Flyway migrations\nschema creation and routines"]
        AuthDb["auth schema"]
        CustomerDb["customer schema"]
        MeterDb["meter schema"]
        BillingDb["billing schema"]
        PaymentDb["payment schema"]
        NotificationDb["notification schema"]
        AuditDb["audit schema"]
        DbRoutines["DB routines and triggers\nbill notification, payment completion"]
    end

    subgraph External["External / Local Services"]
        Smtp["SMTP mail server\nOTP email"]
        FileSystem["Local filesystem\nuploaded files"]
        Docker["Docker Compose\nPostgreSQL container"]
    end

